# Gemini powers fresh topic generation, idea prompts, and optional feedback.
GEMINI_API_KEY=
# Optional model override. Current default is gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# Groq powers optional speech transcription for post-session feedback.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Set true only while developing locally.
FLASK_DEBUG=false
